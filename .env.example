# ---------------------------------------------------------------------------
# GL Fencing Planner — environment template (NO SECRETS IN THIS FILE)
# Copy to `.env.local` for local development. In production set these in your
# host's dashboard (e.g. Vercel → Project → Settings → Environment Variables).
# ---------------------------------------------------------------------------

# PostgreSQL connection string (pooled is fine for the app).
# Local docker-compose default shown. Neon/Vercel integration sets this for you.
DATABASE_URL=postgres://fencing:fencing@localhost:5432/fencing_dev

# Optional: direct (non-pooled) connection used for migrations.
# The Neon integration sets DATABASE_URL_UNPOOLED automatically.
# DATABASE_URL_UNPOOLED=

# Public base URL of the site (used in invite/reset links and emails).
# Leave unset locally; set to your production URL, e.g. https://gl-fencing.vercel.app
# APP_URL=

# One-time administrator bootstrap secret. Generate with:
#   openssl rand -base64 32
# Required to create the FIRST administrator at /setup. Once an administrator
# exists, /setup is permanently disabled and this value is no longer used.
SETUP_TOKEN=

# Break-glass recovery secret. Leave EMPTY normally. Set it only when every
# administrator is locked out, redeploy, use /recover once, then remove it.
# RECOVERY_TOKEN=

# Optional outgoing email for invites and self-service password resets.
# Without these, administrators copy invite/reset links and share them directly.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="GL Fencing <no-reply@example.com>"

# Test database (only used by `npm test`).
# TEST_DATABASE_URL=postgres://fencing:fencing@localhost:5432/fencing_test
